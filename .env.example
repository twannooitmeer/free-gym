# free-gym configuration. Copy to .env and fill in.
#
# Local development (docker-compose.dev.yml + `pnpm dev`) needs only the
# first block; the DATABASE_URL below matches the dev compose defaults.
# Production (docker-compose.yml) needs every value marked REQUIRED.

# ---------- development ----------
# The app reads DATABASE_URL directly. docker-compose.yml builds its own
# from the POSTGRES_* values below and ignores this line.
DATABASE_URL=postgres://freegym:freegym-dev-only@localhost:5432/free_gym

# Tests (pnpm test:int) use this database instead when set, and create it
# on first run. Keep it separate from DATABASE_URL: tests add their own rows.
TEST_DATABASE_URL=postgres://freegym:freegym-dev-only@localhost:5432/free_gym_test

# REQUIRED. Signs session cookies. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# REQUIRED. Bearer token for the scheduled job routes under /api/cron.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---------- production only (docker-compose.yml) ----------
# REQUIRED. Postgres credentials. Choose a long random password.
POSTGRES_USER=freegym
POSTGRES_PASSWORD=
POSTGRES_DB=free_gym

# REQUIRED. The public https:// address of the site. Used in email links
# and as the only origin allowed to use the session cookie.
SITE_URL=

# Optional. Host port the app is published on (bound to 127.0.0.1).
# APP_PORT=3000

# Optional. Container time zone; set it to the gym's so logs and the
# schedule agree.
# TZ=Europe/Amsterdam

# ---------- public demo only ----------
# DEMO_MODE=1 turns an installation into a public demo: a notice with the
# demo logins, no search indexing, frozen shared demo accounts, and
# `pnpm demo:reset` (wipes the database). Never set it for a real gym.
# DEMO_MODE=1
# The demo admin's password (at least 16 characters); required by the seed
# in demo mode, because the site is public.
# SEED_ADMIN_PASSWORD=

# ---------- email (optional) ----------
# Transactional email goes through Resend (https://resend.com), a plain
# HTTPS API. These are fallbacks: the admin panel's Email settings take
# precedence when filled in. Without either, emails are logged to the
# console instead of sent.
# RESEND_API_KEY=
# EMAIL_FROM=Your Gym <hello@mail.example.com>
